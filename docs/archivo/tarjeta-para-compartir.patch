+  // El flyer. El navegador solo deja usar en el dibujo imágenes de sitios que lo autorizan (CORS): Tickantel y
+  // los afiches propios, sí; el resto (RedTickets, el Sodre, la Intendencia…), no. Esos se piden a wsrv.nl, un
+  // servicio gratuito de imágenes (de código abierto) que las entrega con esa autorización. Si igual falla, queda
+  // el respaldo del sitio: el color del tipo de evento con su nombre.
+  const FLYERS_DIRECTOS = new Set(["tickantel.cdn.antel.net.uy", location.host]);
+  function direccionDelFlyer(url) {
+    const absoluta = new URL(url, location.href);
+    if (FLYERS_DIRECTOS.has(absoluta.host)) return absoluta.href;
+    return `https://wsrv.nl/?url=${encodeURIComponent(absoluta.href)}&w=1200&we`;
+  }
+  // Se trae con fetch (y no con una imagen suelta, que algunos navegadores demoran) y se convierte en un mapa de
+  // bits para dibujarlo. Si tarda más de 6 segundos o falla, la tarjeta sale con el respaldo.
+  async function cargarFlyer(url) {
+    if (!url) return null;
+    const corte = new AbortController();
+    const espera = setTimeout(() => corte.abort(), 6000);
+    try {
+      const respuesta = await fetch(direccionDelFlyer(url), { mode: "cors", credentials: "omit", referrerPolicy: "no-referrer", signal: corte.signal });
+      if (!respuesta.ok) return null;
+      return await createImageBitmap(await respuesta.blob());
+    } catch (_) {
+      return null;
+    } finally {
+      clearTimeout(espera);
+    }
+  }
