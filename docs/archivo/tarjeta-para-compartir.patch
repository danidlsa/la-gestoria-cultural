+  // Una etiqueta mostaza inclinada con sombra coral (como las del sitio). Devuelve dónde termina.
+  function etiqueta(ctx, texto, x, y, { tamano = 40, fondo = COLOR.mostaza, sombra = COLOR.coral, giro = -2.5 } = {}) {
+    ctx.save();
