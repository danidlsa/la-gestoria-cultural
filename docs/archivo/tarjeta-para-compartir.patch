+    const precio = evento.precioTexto;
+
+    const ancho = f.tarjeta;
+    const x = (f.ancho - ancho) / 2;
+    const altoFlyer = Math.round(ancho * 9 / 16);
+    const margen = Math.round(ancho * 0.05);
