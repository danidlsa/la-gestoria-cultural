+    const ancho = ctx.measureText(texto).width + tamano * 1.1;
+    const alto = tamano * 1.45;
+    ctx.translate(x, y);
+    ctx.rotate((giro * Math.PI) / 180);
+    ctx.fillStyle = sombra;
+    ctx.beginPath(); ctx.roundRect(10, 10, ancho, alto, alto * 0.32); ctx.fill();
+    ctx.fillStyle = fondo;
+    ctx.beginPath(); ctx.roundRect(0, 0, ancho, alto, alto * 0.32); ctx.fill();
+    ctx.lineWidth = 5; ctx.strokeStyle = COLOR.tinta; ctx.stroke();
+    ctx.fillStyle = COLOR.tinta;
+    ctx.textBaseline = "middle";
+    ctx.fillText(texto, tamano * 0.55, alto / 2 + tamano * 0.03);
+    ctx.restore();
+    return { ancho, alto };
+  }
