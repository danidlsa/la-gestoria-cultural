+    const k = ancho / 888; // las medidas, pensadas para la historia, se achican en el posteo
+    let tamanoTitulo = Math.round(64 * k);
+    let lineasTitulo;
+    for (; tamanoTitulo >= 44 * k; tamanoTitulo -= 2) {
+      ctx.font = `800 ${tamanoTitulo}px "Bricolage Grotesque", sans-serif`;
+      lineasTitulo = renglones(ctx, evento.titulo, anchoTexto);
