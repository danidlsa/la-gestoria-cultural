+.menu-compartir button:hover, .menu-compartir button:focus-visible { background: color-mix(in srgb, var(--mostaza) 30%, transparent); }
+@media (max-width: 600px) {
+  /* En el celular, el menú sale abajo, a todo lo ancho (más fácil de tocar). */
+  .menu-compartir { left: 8px !important; right: 8px; top: auto !important; bottom: 86px; }
+}
+.vista-tarjeta { position: fixed; inset: 0; z-index: 80; display: grid; place-items: center; padding: 16px; background: rgba(24, 38, 74, 0.7); }
+.vista-tarjeta-caja {
+  position: relative; display: flex; flex-direction: column; align-items: center; gap: 12px; max-height: calc(100vh - 32px);
+  background: var(--superficie); color: var(--texto); border: 2px solid var(--borde); border-radius: var(--radio); box-shadow: 6px 6px 0 var(--coral); padding: 18px;
+}
+.vista-tarjeta-img { display: block; max-width: min(78vw, 360px); max-height: calc(100vh - 210px); width: auto; height: auto; border-radius: 10px; border: 2px solid var(--borde); }
+.vista-tarjeta-ayuda { margin: 0; max-width: 360px; text-align: center; font-size: 0.9rem; color: var(--texto-suave); }
+.vista-tarjeta-botones { display: flex; gap: 10px; }
+.vista-tarjeta-botones .boton-principal, .vista-tarjeta-botones .boton-secundario { min-height: 42px; padding: 8px 18px; font-size: 1rem; text-decoration: none; display: inline-flex; align-items: center; }
+.vista-tarjeta-cerrar {
+  position: absolute; top: -14px; right: -14px; display: inline-grid !important; place-items: center; width: 40px; height: 40px;
+  border: 2px solid var(--borde); border-radius: 50%; background: var(--superficie); color: var(--texto); font-size: 1.4rem; font-weight: 800; line-height: 1; cursor: pointer;
+}
