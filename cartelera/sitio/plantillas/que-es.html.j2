<!doctype html>
<html lang="es-UY">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>¿Qué es {{ sitio }}?</title>
  <meta name="description" content="Quién hace {{ sitio }}, de dónde salen los datos y por qué.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,700&display=swap">
  <!-- El tema elegido se aplica antes de dibujar, para que no parpadee. -->
  <script>try { if (localStorage.getItem("lgc-tema") === "oscuro") document.documentElement.dataset.tema = "oscuro"; } catch (_) {}</script>
  <link rel="stylesheet" href="estilos.css">
</head>
<body>
  <header class="cabezal">
    <div class="contenedor cabezal-interior">
      <div class="marca">
        <h1><a href="index.html">La Gestoría <span>Cultural</span></a></h1>
        <p class="bajada">Qué hacer en Montevideo: teatro, música, danza y mucho más, de todas las salas en un solo lugar.</p>
      </div>
      <p class="cifras"><button type="button" class="boton-tema" id="boton-tema" aria-pressed="false" aria-label="Modo oscuro"><span class="tema-icono" aria-hidden="true">☾</span> <span class="tema-texto" aria-hidden="true">Oscuro</span></button></p>
    </div>
    <nav class="contenedor secciones" aria-label="Secciones">
      <a class="pastilla" href="index.html">← Volver a la cartelera</a>
      <a class="pastilla aparte activa" href="que-es.html" aria-current="page">¿Qué es La Gestoría?</a>
    </nav>
  </header>

  <main class="contenedor">
    <article class="que-es">
      {{ contenido }}
    </article>
    <section class="que-es-fuentes" id="fuentes" aria-labelledby="titulo-fuentes">
      <h2 id="titulo-fuentes">De dónde salen los datos</h2>
      <p>Hoy {{ sitio }} junta lo que publican {{ nombres_fuentes[:-1]|join(", ") }} y {{ nombres_fuentes[-1] }}.</p>
    </section>
  </main>
  <footer class="contenedor pie-pagina">
    <p><strong>{{ sitio }}</strong> · Montevideo, 2026 · Proyecto sin fines de lucro</p>
    <p>Cada evento enlaza a su fuente original para comprar o reservar.
       <a href="que-es.html">Qué es</a> · <a href="#fuentes">Fuentes</a> · <a href="https://github.com/danidlsa/la-gestoria-cultural">Código</a> · <a href="eventos.json">Datos</a></p>
  </footer>
  <script src="tema.js"></script>
</body>
</html>
