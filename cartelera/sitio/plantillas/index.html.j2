<!doctype html>
<html lang="es-UY">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ sitio }}</title>
  <meta name="description" content="Qué hacer en Montevideo: teatro, música, danza y más, de todas las salas en un solo lugar.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,800&family=DM+Sans:opsz,wght@9..40,400;9..40,600;9..40,700&display=swap">
  <!-- El tema elegido se aplica antes de dibujar, para que no parpadee. -->
  <script>try { if (localStorage.getItem("lgc-tema") === "oscuro") document.documentElement.dataset.tema = "oscuro"; } catch (_) {}</script>
  <link rel="stylesheet" href="estilos.css">
</head>
<body>
  <a class="saltar" href="#resultados">Saltar a los eventos</a>
  <header class="cabezal">
    <div class="contenedor cabezal-interior">
      <div class="marca">
        <h1>La Gestoría <span>Cultural</span></h1>
        <p class="bajada">Qué hacer en Montevideo: teatro, música, danza y mucho más, de todas las salas en un solo lugar.</p>
      </div>
      <p class="cifras">
        <span><strong>{{ eventos|length }}</strong> eventos</span>
        <span><strong>{{ salas|length }}</strong> salas</span>
        <span class="actualizado">Actualizado {{ generado }}</span>
        <button type="button" class="boton-tema" id="boton-tema" aria-pressed="false" aria-label="Modo oscuro"><span class="tema-icono" aria-hidden="true">☾</span> <span class="tema-texto" aria-hidden="true">Oscuro</span></button>
      </p>
    </div>
    <div class="contenedor buscador" role="search">
      <label for="buscar" class="solo-lectores">Buscar eventos</label>
      <svg class="lupa" viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5" fill="none" stroke="currentColor" stroke-width="2.5"/><path d="M15.5 15.5 21 21" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg>
      <input type="search" id="buscar" placeholder="Buscá una obra, artista, sala…" autocomplete="off">
    </div>
    <nav class="contenedor secciones" aria-label="Secciones">
      <button type="button" data-seccion="agenda" class="activa">Agenda</button>
      <button type="button" data-seccion="plan" class="destacada"><span class="chispa" aria-hidden="true">✦</span> Planeá tu mes <span class="cuenta" id="cuenta-plan">0</span></button>
      <button type="button" data-seccion="mapa">Mapa</button>
      <button type="button" data-seccion="gratis">Gratis <span class="cuenta">{{ cantidad_gratis }}</span></button>
      <button type="button" data-seccion="promos">Promos <span class="cuenta">{{ cantidad_promos }}</span></button>
      <button type="button" data-seccion="festivales">Festivales <span class="cuenta">{{ cantidad_festivales }}</span></button>
      <button type="button" data-seccion="especiales">Especiales</button>
      <a class="pastilla aparte" href="que-es.html">¿Qué es La Gestoría?</a>
    </nav>
  </header>

  <div class="contenedor principal">
    <aside class="filtros" id="filtros" aria-labelledby="filtros-nombre">
      <div class="filtros-titulo">
        <h2 id="filtros-nombre">Filtros</h2>
        <button type="button" class="borrar-todo" data-borrar="todo" hidden>Borrar todo</button>
        <button type="button" class="cerrar-filtros" data-cerrar-filtros aria-label="Cerrar filtros">×</button>
      </div>

      <section class="campo" id="campo-fecha">
        <h3 id="titulo-fecha">Fecha</h3>
        <div class="atajos" id="atajos-fecha" role="group" aria-label="Período">
          <button type="button" data-periodo="hoy">Hoy</button>
          <button type="button" data-periodo="finde">Este finde</button>
          <button type="button" data-periodo="semana">7 días</button>
          <button type="button" data-periodo="todo" class="activo">Todo</button>
        </div>
        <details class="plegable" open>
          <summary>Calendario</summary>
          <div class="calendario" id="calendario">
            <div class="cal-cabezal">
              <button type="button" class="cal-flecha" data-mes="-1" aria-label="Mes anterior">‹</button>
              <span id="cal-mes"></span>
              <button type="button" class="cal-flecha" data-mes="1" aria-label="Mes siguiente">›</button>
            </div>
            <div class="cal-dias" aria-hidden="true"><span>L</span><span>M</span><span>M</span><span>J</span><span>V</span><span>S</span><span>D</span></div>
            <div class="cal-grilla" id="cal-grilla"></div>
          </div>
        </details>
      </section>

      <details class="plegable" open>
        <summary>Más filtros</summary>

        <section class="campo">
          <h3>Tipo de evento</h3>
          <div class="opciones plegada" id="rubros" role="group" aria-label="Tipo de evento">
            <button type="button" data-categoria="" class="activo">Todos</button>
            {%- for atributo, clave, nombre in rubros %}
            <button type="button" data-{{ atributo }}="{{ clave }}"{% if loop.index > rubros_visibles %} class="extra"{% endif %}>{{ nombre }}</button>
            {%- endfor %}
            {%- if rubros|length > rubros_visibles %}
            {%- set texto_mas = "Más tipos (" ~ (rubros|length - rubros_visibles) ~ ")" %}
            <button type="button" class="ver-mas" data-ver-mas data-texto-mas="{{ texto_mas }}" aria-expanded="false">{{ texto_mas }}</button>
            {%- endif %}
          </div>
          <div class="opciones subrubros" id="subrubros" role="group" aria-label="Subtipo" hidden></div>
          <details class="excluir" id="excluir">
            <summary>Excluir <span class="cuenta-excluir" id="cuenta-excluir" hidden></span></summary>
            <p class="ayuda">Tocá lo que no querés ver. Queda guardado en este navegador.</p>
            <div class="opciones" id="excluidos" role="group" aria-label="Tipos de evento excluidos">
              {%- for clave, nombre, cantidad in categorias %}
              <button type="button" data-excluir="{{ clave }}" aria-pressed="false">{{ nombre }}</button>
              {%- endfor %}
              <button type="button" data-excluir="festival" aria-pressed="false">Festivales</button>
              <button type="button" data-excluir="museo" aria-pressed="false">Museos</button>
            </div>
          </details>
        </section>

        <section class="campo">
          <h3>Precio</h3>
          <div class="opciones" id="presupuestos" role="group" aria-label="Precio">
            <button type="button" data-presupuesto="" class="activo">Cualquiera</button>
            {%- for clave, nombre, detalle in presupuestos %}
            <button type="button" data-presupuesto="{{ clave }}" title="{{ detalle }}">{{ nombre }}{% if detalle %} <small>{{ detalle }}</small>{% endif %}</button>
            {%- endfor %}
          </div>
        </section>

        <section class="campo" id="campo-promos" hidden>
          <h3>Programa de beneficios</h3>
          <div class="opciones plegada" id="programas" role="group" aria-label="Programa">
            <button type="button" data-programa="" class="activo">Todos</button>
            {%- for programa, cantidad in promos %}
            <button type="button" data-programa="{{ programa }}"{% if loop.index > programas_visibles %} class="extra"{% endif %}>{{ programa }} <small>{{ cantidad }}</small></button>
            {%- endfor %}
            {%- if promos|length > programas_visibles %}
            {%- set texto_mas = "Más programas (" ~ (promos|length - programas_visibles) ~ ")" %}
            <button type="button" class="ver-mas" data-ver-mas data-texto-mas="{{ texto_mas }}" aria-expanded="false">{{ texto_mas }}</button>
            {%- endif %}
          </div>
        </section>

        <section class="campo">
          <h3><label for="sala">Sala</label></h3>
          <select id="sala">
            <option value="">Todas las salas</option>
            {%- for id_, nombre, cantidad in salas %}
            <option value="{{ id_ }}">{{ nombre }} ({{ cantidad }})</option>
            {%- endfor %}
          </select>
        </section>

      </details>
      <div class="filtros-pie">
        <button type="button" class="boton-principal ver-eventos" data-cerrar-filtros>Ver los eventos</button>
      </div>
    </aside>
    <div class="velo" id="velo" hidden></div>

    <main class="resultados" id="resultados" tabindex="-1">
      <!-- En el celular: los atajos de fecha a mano. El botón "Filtros" va en la barra fija y abre el panel lateral. -->
      <div class="barra-movil">
        <div class="atajos" role="group" aria-label="Período">
          <button type="button" data-periodo="hoy">Hoy</button>
          <button type="button" data-periodo="finde">Este finde</button>
          <button type="button" data-periodo="semana">7 días</button>
          <button type="button" data-periodo="todo" class="activo">Todo</button>
        </div>
      </div>
      <div class="intro" id="intro" hidden></div>
      <div class="barra" id="barra">
        <p class="resumen" id="resumen" aria-live="polite"></p>
        <button type="button" class="abrir-filtros" data-abrir-filtros aria-controls="filtros" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true" width="18" height="18"><path d="M3 6h18M7 12h10M10 18h4" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" fill="none"/></svg>
          Filtros <span class="cuenta-filtros" hidden></span>
        </button>
        <div class="activos" id="activos" role="group" aria-label="Filtros activos"></div>
      </div>

      <div class="carriles" id="carriles"></div>
      <div class="mapa" id="mapa" hidden></div>
      <ul class="mapa-leyenda" id="mapa-leyenda" aria-label="Colores del mapa" hidden>
        {%- for tipo, nombre in tipos_de_lugar.items() %}
        <li><span class="punto-leyenda tipo-{{ tipo }}" aria-hidden="true"></span>{{ nombre }}</li>
        {%- endfor %}
      </ul>

      <section class="especiales" id="especiales" aria-label="Eventos especiales" hidden>
        {%- for e in especiales %}
        <article class="especial{% if e.actividades %} con-programa{% endif %}{% if e.en_curso %} en-curso{% endif %}" id="especial-{{ e.id }}">
          <p class="especial-faltan">{{ e.faltan_texto }}</p>
          <h3>{{ e.nombre }}</h3>
          <p class="especial-fecha">{{ e.fecha_texto }}
            {%- if e.estimada %} <span class="especial-nota">· fecha estimada</span>
            {%- elif e.a_confirmar %} <span class="especial-nota">· fecha a confirmar</span>{% endif %}</p>
          <p>{{ e.descripcion }}</p>
          {%- if e.actividades %}
          <details class="especial-programa"{% if e.actividades|length <= 6 %} open{% endif %}>
            <summary>{{ e.actividades|length }} {{ "actividad" if e.actividades|length == 1 else "actividades" }} en la cartelera</summary>
            <ul>
              {%- for a in e.actividades %}
              <li><span class="especial-cuando">{{ a.cuando }}</span> <a href="{{ a.url }}" target="_blank" rel="noopener">{{ a.titulo }}</a>{% if a.lugar %} <span class="especial-lugar">· {{ a.lugar }}</span>{% endif %}</li>
              {%- endfor %}
            </ul>
          </details>
          {%- else %}
          <p class="especial-sin-programa">Todavía no hay programa. Suele ser {{ e.cuando }}: cuando se publique, las actividades aparecen acá.</p>
          {%- endif %}
          <a class="especial-sitio" href="{{ e.sitio }}" target="_blank" rel="noopener">Sitio oficial ↗</a>
        </article>
        {%- endfor %}
      </section>

      <section class="plan" id="plan" hidden>
        <section class="plan-cal" aria-label="Calendario de tu plan">
          <div class="pc-cabezal">
            <button type="button" class="cal-flecha" data-plan-mes="-1" aria-label="Mes anterior">‹</button>
            <h2 id="pc-titulo"></h2>
            <button type="button" class="cal-flecha" data-plan-mes="1" aria-label="Mes siguiente">›</button>
          </div>
          <div class="pc-semana" aria-hidden="true"><span>Lun</span><span>Mar</span><span>Mié</span><span>Jue</span><span>Vie</span><span>Sáb</span><span>Dom</span></div>
          <div class="pc-grilla" id="pc-grilla"></div>
        </section>
        <div class="mi-plan" id="mi-plan" aria-live="polite">
          <div class="mi-plan-cabezal">
            <h2>Mi plan</h2>
            <button type="button" class="borrar-todo" data-vaciar-plan>Vaciar</button>
          </div>
          <div class="mi-plan-acciones" id="mi-plan-acciones">
            <!-- Íconos de marca: Simple Icons (CC0). -->
            <button type="button" class="boton-secundario con-icono" data-exportar="google" title="Sumá cada evento a Google Calendar"><svg class="icono" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M18.316 5.684H24v12.632h-5.684V5.684zM5.684 24h12.632v-5.684H5.684V24zM18.316 5.684V0H1.895A1.894 1.894 0 0 0 0 1.895v16.421h5.684V5.684h12.632zm-7.207 6.25v-.065c.272-.144.5-.349.687-.617s.279-.595.279-.982c0-.379-.099-.72-.3-1.025a2.05 2.05 0 0 0-.832-.714 2.703 2.703 0 0 0-1.197-.257c-.6 0-1.094.156-1.481.467-.386.311-.65.671-.793 1.078l1.085.452c.086-.249.224-.461.413-.633.189-.172.445-.257.767-.257.33 0 .602.088.816.264a.86.86 0 0 1 .322.703c0 .33-.12.589-.36.778-.24.19-.535.284-.886.284h-.567v1.085h.633c.407 0 .748.109 1.02.327.272.218.407.499.407.843 0 .336-.129.614-.387.832s-.565.327-.924.327c-.351 0-.651-.103-.897-.311-.248-.208-.422-.502-.521-.881l-1.096.452c.178.616.505 1.082.977 1.401.472.319.984.478 1.538.477a2.84 2.84 0 0 0 1.293-.291c.382-.193.684-.458.902-.794.218-.336.327-.72.327-1.149 0-.429-.115-.797-.344-1.105a2.067 2.067 0 0 0-.881-.689zm2.093-1.931l.602.913L15 10.045v5.744h1.187V8.446h-.827l-2.158 1.557zM22.105 0h-3.289v5.184H24V1.895A1.894 1.894 0 0 0 22.105 0zm-3.289 23.5l4.684-4.684h-4.684V23.5zM0 22.105C0 23.152.848 24 1.895 24h3.289v-5.184H0v3.289z"/></svg> Google Calendar</button>
            <button type="button" class="boton-secundario con-icono" data-exportar="ics" title="Descarga un archivo .ics: se abre con el calendario de Apple, Outlook y casi todos los calendarios"><svg class="icono" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="currentColor" d="M12.152 6.896c-.948 0-2.415-1.078-3.96-1.04-2.04.027-3.91 1.183-4.961 3.014-2.117 3.675-.546 9.103 1.519 12.09 1.013 1.454 2.208 3.09 3.792 3.039 1.52-.065 2.09-.987 3.935-.987 1.831 0 2.35.987 3.96.948 1.637-.026 2.676-1.48 3.676-2.948 1.156-1.688 1.636-3.325 1.662-3.415-.039-.013-3.182-1.221-3.22-4.857-.026-3.04 2.48-4.494 2.597-4.559-1.429-2.09-3.623-2.324-4.39-2.376-2-.156-3.675 1.09-4.61 1.09zM15.53 3.83c.843-1.012 1.4-2.427 1.245-3.83-1.207.052-2.662.805-3.532 1.818-.78.896-1.454 2.338-1.273 3.714 1.338.104 2.715-.688 3.559-1.701"/></svg> Apple / Outlook</button>
            <a class="boton-secundario con-icono" id="compartir-whatsapp" href="https://wa.me/" target="_blank" rel="noopener"><svg class="icono" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#25D366" d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg> WhatsApp</a>
            <button type="button" class="boton-secundario con-icono" data-exportar="imprimir" title="Un calendario del mes para imprimir o guardar como PDF"><svg class="icono" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 9V3h10v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M7 14h10v7H7z"/></svg> Imprimir</button>
            <button type="button" class="boton-secundario con-icono" data-exportar="copiar"><svg class="icono" viewBox="0 0 24 24" width="18" height="18" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="8" y="8" width="13" height="13" rx="2"/><path d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"/></svg> Copiar</button>
            <span class="aviso-copiado" id="aviso-copiado" role="status" hidden>¡Copiado!</span>
          </div>
          <p class="mi-plan-vacio" id="mi-plan-vacio">Tu mes está vacío. Tocá un día del calendario para ver qué hay, y <strong>＋</strong> en lo que te interese.</p>
          <details class="mi-plan-detalle" id="mi-plan-detalle">
            <summary>Ver como lista, con enlaces a Google Calendar</summary>
            <ol class="mi-plan-lista" id="mi-plan-lista"></ol>
          </details>
        </div>
        <h2 class="plan-opciones-titulo">Qué hay para elegir</h2>
        <div class="plan-dias" id="plan-dias"></div>
      </section>
      <ul class="eventos" id="eventos" hidden>
        {%- macro beneficio_texto(beneficio) -%}
        {%- if beneficio.programa in ("2x1 para todos", "Promo grupal", "Otras promos") -%}{{ beneficio.programa }}
        {%- else -%}{{ "2x1" if beneficio.tipo == "2x1" else "Descuento" }} · {{ beneficio.programa }}{%- endif -%}
        {%- endmacro %}
        {%- for evento in eventos %}
        {%- set lugar = lugares.get(evento.lugar_id, {}) %}
        {%- set proxima = evento.funciones[0] %}
        {%- set nivel = evento.precio|presupuesto %}
        {%- set principal = evento|entrada_principal %}
        {%- set enlace = principal.url if principal else evento.fuentes[0].url %}
        <li class="evento cat-{{ evento.categoria }}" data-id="{{ evento.id }}">
          <a class="flyer" href="{{ enlace }}" target="_blank" rel="noopener" tabindex="-1" aria-hidden="true">
            {%- if evento.imagen_url %}
            <img src="{{ evento.imagen_url }}" alt="" loading="lazy" referrerpolicy="no-referrer" onerror="this.remove()">
            {%- endif %}
            <span class="flyer-respaldo">{{ nombres_categoria[evento.categoria] }}</span>
            <span class="insignias">
              {%- if nivel == "gratis" %}<span class="insignia insignia-gratis">Gratis</span>{% endif %}
              {%- if evento.beneficios|selectattr("tipo", "equalto", "2x1")|list %}<span class="insignia insignia-promo">2x1</span>{% endif %}
              {%- if evento.funciones|selectattr("agotada")|list|length == evento.funciones|length %}<span class="insignia insignia-agotado">Agotado</span>{% endif %}
            </span>
          </a>
          <div class="cuerpo">
            <p class="tipo">{{ nombres_categoria[evento.categoria] }}{% if evento.subcategoria in nombres_subcategoria %} · {{ nombres_subcategoria[evento.subcategoria] }}{% endif %}</p>
            <h3><a href="{{ enlace }}" target="_blank" rel="noopener">{{ evento.titulo }}</a></h3>
            <p class="lugar"><button type="button" class="enlace-sala" data-sala="{{ evento.lugar_id }}">{{ lugar.get("nombre", "") }}</button></p>
            {%- set barrios = evento.funciones|map(attribute="sala")|select|unique|list %}
            {%- if lugar.get("nombre") == varios_barrios and barrios|length > 1 %}
            <details class="barrios"><summary>En {{ barrios|length }} lugares</summary><p>{{ barrios|join(" · ") }}</p></details>
            {%- endif %}
            {%- if evento.muestra %}
            {#- Una exposición se muestra con su período, no con una función por día. #}
            <p class="cuando"><span class="periodo">{{ evento|periodo_muestra }}</span></p>
            {%- else %}
            <p class="cuando">
              <time class="proxima" datetime="{{ proxima.inicio }}">{{ proxima.inicio|fecha_corta(proxima.sin_hora) }}</time>
              {%- if evento.funciones|length > 1 %}
              <span class="mas">+{{ evento.funciones|length - 1 }} función{{ "es" if evento.funciones|length > 2 }}</span>
              {%- endif %}
            </p>
            {%- endif %}
            {%- if evento.ciclo_id and evento.ciclo_id in ciclos %}
            {%- set titulo_ciclo = ciclos[evento.ciclo_id].titulo %}
            <p class="ciclo"><button type="button" class="enlace-ciclo" data-ciclo="{{ evento.ciclo_id }}">{{ titulo_ciclo if titulo_ciclo.lower().startswith("ciclo") else "Ciclo: " ~ titulo_ciclo }}</button></p>
            {%- endif %}
            <div class="pie">
              {%- set precio = evento.precio|precio_texto %}
              {%- if precio %}<span class="precio">{{ precio }}</span>{% endif %}
              {%- set promos = evento|promos_ordenadas %}
              {%- for beneficio in promos[:promos_visibles] %}
              <span class="beneficio">{{ beneficio_texto(beneficio) }}</span>
              {%- endfor %}
              {%- if promos|length > promos_visibles %}
              <details class="mas-promos">
                <summary>+{{ promos|length - promos_visibles }} promo{{ "s" if promos|length - promos_visibles > 1 }}</summary>
                {%- for beneficio in promos[promos_visibles:] %}
                <span class="beneficio">{{ beneficio_texto(beneficio) }}</span>
                {%- endfor %}
              </details>
              {%- endif %}
            </div>
            <p class="via">
              {%- if principal %}
              <a href="{{ principal.url }}" target="_blank" rel="noopener">{{ "Ver en" if principal.via in solo_informacion else "Entradas en" }} {{ fuentes.get(principal.via, principal.via) }} ↗</a>
              {%- endif %}
              <button type="button" class="agregar-plan">＋ Mi plan</button>
            </p>
          </div>
        </li>
        {%- endfor %}
      </ul>
      <div class="vacio" id="vacio" hidden>
        <p>No hay eventos con estos filtros.</p>
        <button type="button" data-borrar="todo">Borrar filtros</button>
      </div>
    </main>
  </div>

  <footer class="contenedor pie-pagina">
    <p><strong>{{ sitio }}</strong> · Montevideo, 2026 · Proyecto sin fines de lucro</p>
    <p>Cada evento enlaza a su fuente original para comprar o reservar.
       <a href="que-es.html">Qué es</a> · <a href="que-es.html#fuentes">Fuentes</a> · <a href="https://docs.google.com/forms/d/e/1FAIpQLSckAwGEcbi1d2X5UHb0nNBAMZ6AnbqtBwHU_MD2ciX_PHLDxg/viewform">Contacto</a> · <a href="https://github.com/danidlsa/la-gestoria-cultural">Código</a> · <a href="eventos.json">Datos</a></p>
  </footer>

  <div class="imprimible" id="imprimible" aria-hidden="true"></div>

  <script id="datos" type="application/json">{{ datos_json|safe }}</script>
  <script src="app.js"></script>
  <script src="tema.js"></script>
</body>
</html>
